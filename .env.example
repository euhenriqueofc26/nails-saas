# =============================================
# ClubNailsBrasil - Variaveis de Ambiente
# =============================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commit o arquivo .env com valores reais
# =============================================

# --- Banco de Dados (Neon PostgreSQL) ---
DATABASE_URL="postgresql://neondb_owner:SENHA@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Autenticacao (OBRIGATORIO) ---
JWT_SECRET="gerar-string-forte-minimo-32-caracteres"

# --- CEO / Admin (OBRIGATORIO) ---
CEO_EMAIL="seu-email@email.com"
NEXT_PUBLIC_CEO_EMAIL="seu-email@email.com"

# --- URL da Aplicacao ---
NEXT_PUBLIC_APP_URL="https://www.clubnailsbrasil.com.br"
NEXT_PUBLIC_BASE_URL="https://www.clubnailsbrasil.com.br"
APP_URL="https://www.clubnailsbrasil.com.br"

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL="http://77.37.41.176:4000"
EVOLUTION_API_KEY="sua-chave-evolution-api"

# --- Groq AI (IA Secretaria) ---
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Cloudinary (Upload de Imagens) ---
CLOUDINARY_CLOUD_NAME="dwgisa6yv"
CLOUDINARY_API_KEY="sua-chave-api-cloudinary"
CLOUDINARY_API_SECRET="seu-secreto-cloudinary"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dwgisa6yv"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="nails-upload"

# --- Google Analytics ---
NEXT_PUBLIC_GA_ID="G-LBXSR68S0X"

# --- Cron Protection (OBRIGATORIO para crons) ---
CRON_SECRET="gerar-string-forte-minimo-32-caracteres"

# --- Redis / Upstash (Rate Limiting e Revogacao de Token) ---
# Se usar Vercel KV, configure KV_REST_API_URL e KV_REST_API_TOKEN
# O Vercel KV mapeia automaticamente para UPSTASH_REDIS_REST_URL e UPSTASH_REDIS_REST_TOKEN
KV_REST_API_URL="https://xxx.upstash.io"
KV_REST_API_TOKEN="AXxxxxxxxxxxxxxxxxxxxxx"
